to counter with start:
    set n to start
    to bump:
        set n to n + 1
        give back n
    give back bump

set c to counter(10)
say c()
say c()

set d to counter(100)
say d()
say c()

to add with a, b:
    give back a + b

set f to add
say f(2, 3)
say f

to make_adder with n:
    to adder with x:
        give back x + n
    give back adder

set add5 to make_adder(5)
say add5(10)
say add5(20)
