set score to 0
ask "What is 2 + 2? " into answer1
if answer1 is "4":
    say "Correct!"
    set score to score + 1
otherwise:
    say "Oops, it is 4."
ask "What color is the sky? " into answer2
if answer2 is "blue":
    say "Correct!"
    set score to score + 1
otherwise:
    say "Oops, it is blue."
say "Your score:", score, "out of 2"
