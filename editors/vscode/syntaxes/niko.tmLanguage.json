{
  "fileTypes": [
    "niko"
  ],
  "name": "Niko",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#string-single"
    },
    {
      "include": "#number"
    },
    {
      "include": "#function-def"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#type-annotation"
    },
    {
      "include": "#builtin"
    }
  ],
  "repository": {
    "builtin": {
      "match": "\\b(text|number|length|item_of|upper|lower|trim|replace|split|join|sorted|reversed|unique|sum|average|max|min|abs|ceil|floor|round|sqrt|pi|random_int|niko_range|has|today|now|sleep|keys|starts_with|ends_with|count_of|pick|write_file|append_file|read_file|read_lines|file_exists|ok|error|is_ok|is_error|unwrap|unwrap_or|error_message|try_read_file|try_number)\\b",
      "name": "support.function.niko"
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.niko"
    },
    "constant": {
      "match": "\\b(yes|no|nothing)\\b",
      "name": "constant.language.niko"
    },
    "function-def": {
      "begin": "^\\s*(to)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.niko"
        },
        "2": {
          "name": "entity.name.function.niko"
        }
      },
      "end": ":",
      "name": "meta.function.niko",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "match": "\\bwith\\b|\\band\\b",
          "name": "variable.parameter.niko"
        },
        {
          "include": "#type-annotation"
        }
      ]
    },
    "keyword": {
      "match": "\\b(set|say|if|otherwise|match|when|to|give back|for each|while|repeat|times|stop|skip|ask|put|remove|add|take|from|into|use|with|import|as)\\b",
      "name": "keyword.control.niko"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.niko"
    },
    "operator": {
      "match": "\\b(is bigger than|is smaller than|is at least|is at most|is not|is in|and|or|not|is|in)\\b",
      "name": "keyword.operator.niko"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.niko",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.niko"
        }
      ]
    },
    "type-annotation": {
      "captures": {
        "2": {
          "name": "storage.type.niko"
        }
      },
      "match": "(:|<|,)\\s*(number|text|yes/no|list|record|option|result|any|nothing)\\b"
    },
    "string-single": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.niko",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.niko"
        }
      ]
    }
  },
  "scopeName": "source.niko"
}